# Chạy trực tiếp (không Docker): giữ 127.0.0.1.
# Docker Desktop: đổi LLM_BASE_URL thành http://host.docker.internal:11434/v1.
# Chỉ dùng Ollama local qua OpenAI-compatible API.
USE_LLM=1
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5-coder:3b
LLM_TEMPERATURE=0
LLM_TIMEOUT=300
LLM_PARSE_RETRIES=1
LLM_REASONING_EFFORT=
LLM_STRUCTURED_OUTPUT=json_object

# Token đầu ra theo từng tầng.
LLM_MAX_TOKENS=3000
FILTER_MAX_TOKENS=2500
GAP_MAX_TOKENS=800

# Ollama local không cần giãn nhịp hoặc retry giới hạn tốc độ.
LLM_RATE_LIMIT_RETRIES=0
LLM_MAX_WAIT=0
LLM_MIN_INTERVAL=0

# Giới hạn và công cụ tầng 1.
MAX_CODE_LENGTH=5000
BANDIT_TIMEOUT=30
USE_RUFF=1
RUFF_TIMEOUT=30
USE_STATIC=1
STATIC_MAX_NESTING=4
STATIC_MIN_DUP_STMTS=4
STATIC_MIN_DUP_BLOCK=3

# Tầng lọc và tìm lỗi còn thiếu.
FILTER_CONTEXT_LINES=10
FILTER_MAX_CANDIDATES=15
USE_GAP_LAYER=1
GAP_MAX_ISSUES=3
