# Copy file nay thanh `.env` roi sua gia tri.
# cp .env.example .env   (Windows: Copy-Item .env.example .env)

# --- Bat/tat LLM ---
# USE_LLM=0  -> chi chay Bandit (khong can API key)
USE_LLM=1

# --- API key ---
# OpenAI:      https://api.openai.com/v1        + key sk-...
# OpenRouter:  https://openrouter.ai/api/v1    + key sk-or-...
# Ollama local (mien phi): http://localhost:11434/v1  + de trong API key
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# --- Gioi han ---
MAX_CODE_LENGTH=20000
BANDIT_TIMEOUT=30
LLM_TIMEOUT=90
